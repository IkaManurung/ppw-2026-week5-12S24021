            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pustakawan@del.ac.id\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const token = j.token || (j.data && j.data.token);",
                  "if (token) pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
